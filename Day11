### 📝 Practice (Statistical Analysis & Feature Engineering)

```python
from pyspark.sql import functions as F
from pyspark.sql.window import Window

# Descriptive statistics
events.describe(["price"]).show()

# Hypothesis testing: Weekday vs Weekend behavior
events = events.withColumn(
    "is_weekend",
    F.dayofweek("event_date").isin([1, 7])
)

events.groupBy("is_weekend", "event_type") \
      .count() \
      .orderBy("is_weekend") \
      .show()

# Correlation analysis
events.stat.corr("price", "user_id")

# Feature engineering for ML
features = events.withColumn("hour", F.hour("event_time")) \
    .withColumn("day_of_week", F.dayofweek("event_date")) \
    .withColumn("price_log", F.log(F.col("price") + 1)) \
    .withColumn(
        "time_since_first_event",
        F.unix_timestamp("event_time") -
        F.first("event_time").over(
            Window.partitionBy("user_id").orderBy("event_time")
        )
    )

features.show(5)
